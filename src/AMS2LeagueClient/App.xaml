<Application x:Class="AMS2LeagueClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <FontFamily x:Key="HudFontFamily">Noto Sans KR, Malgun Gothic, Segoe UI</FontFamily>
        <Style x:Key="HudNumericText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Typography.NumeralStyle" Value="Lining" />
        </Style>
    </Application.Resources>
</Application>
