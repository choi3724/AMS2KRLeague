<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns per-monitor DPI through app.manifest; WinForms is used only for ColorDialog. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>AMS2LeagueClient</AssemblyName>
    <RootNamespace>AMS2LeagueClient</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AMS2LeagueClient.Core\AMS2LeagueClient.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="ThirdParty\OpenVR\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty\OpenVR\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\Hud\*.png" />
    <Resource Include="Assets\Fonts\Pretendard-Medium.otf" />
    <Resource Include="Assets\Fonts\AvanteN-*.ttf" />
    <None Update="Assets\Fonts\AvanteN-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\Pretendard-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Runtime\ApplyUpdate.ps1" LogicalName="AMS2LeagueClient.ApplyUpdate.ps1" />
  </ItemGroup>
</Project>
