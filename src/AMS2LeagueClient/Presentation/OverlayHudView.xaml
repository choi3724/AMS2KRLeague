<UserControl x:Class="AMS2LeagueClient.Presentation.OverlayHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core"
             Width="520" Height="570"
             FontFamily="{DynamicResource HudFontFamily}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             IsHitTestVisible="False">
    <Border CornerRadius="8" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="#8A4DE3B1" BorderThickness="1" Padding="8,7">
        <StackPanel>
            <ItemsControl x:Name="RankingItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="36" Margin="0,1" Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0" Padding="7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Position}" Foreground="{Binding Foreground}" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontBody}" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding Foreground}" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontDriverName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,7,0" />
                                <Border Grid.Column="2" Background="{Binding ClassBackground}" CornerRadius="3" Padding="4,1" Margin="4,4,5,4" HorizontalAlignment="Right" VerticalAlignment="Stretch" MinWidth="55" MaxWidth="95">
                                    <TextBlock Text="{Binding Class}" Foreground="{Binding ClassForeground}" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontClass}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding CurrentTime}" Foreground="{Binding TimeForeground}" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontTiming}" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Visibility="{Binding IsDiagnostic, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="#33445A70" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,7,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DiagnosticLabel}" Foreground="#B68CFF" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}"/>
                    <TextBlock Text="{Binding ParticipantCount, StringFormat=원본 참가자: {0}}" Foreground="#DDE7F1" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                    <TextBlock Text="{Binding LeagueParticipantCount, StringFormat=리그 참가자: {0}}" Foreground="#DDE7F1" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                    <TextBlock Text="{Binding SafetyCarsExcluded, StringFormat=제외된 세이프티카: {0}}" Foreground="#FFD166" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                    <TextBlock Text="{Binding TrackLengthText, StringFormat=트랙 길이: {0}}" Foreground="#DDE7F1" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                    <TextBlock Text="{Binding EventTimeRemainingText, StringFormat=원본 남은 시간: {0}}" Foreground="#DDE7F1" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                    <TextBlock Text="{Binding CurrentEventText, StringFormat=이벤트: {0}}" Foreground="#B68CFF" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                    <TextBlock Text="{Binding DiagnosticParticipantText, StringFormat=참가자: {0}}" Foreground="#DDE7F1" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                    <TextBlock Text="{Binding DerivedRaceControlText, StringFormat=Race Control: {0}}" Foreground="#82F1D0" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
