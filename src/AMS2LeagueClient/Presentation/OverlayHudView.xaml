<UserControl x:Class="AMS2LeagueClient.Presentation.OverlayHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core"
             Width="368"
             FontFamily="{DynamicResource HudFontFamily}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             IsHitTestVisible="False">
    <Border CornerRadius="7" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="#8A4DE3B1" BorderThickness="1" Padding="10">
        <StackPanel>
            <Grid Height="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="AMS2 LEAGUE · TIMING" Foreground="#F7FAFC" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontTitle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding RankingRangeText}" Foreground="#82F1D0" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="3,4,3,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="리그 순위" Foreground="#82F1D0" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="SemiBold" />
                <TextBlock x:Name="RankingRange" Grid.Column="1" Foreground="#71859B" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" FontWeight="Medium" Style="{StaticResource HudNumericText}" />
            </Grid>

            <ItemsControl x:Name="RankingItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="20" Margin="0,1" Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="2,0,0,0" Padding="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Position}" Foreground="{Binding Foreground}" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding Foreground}" FontWeight="Medium" FontSize="{x:Static core:OverlayUiMetrics.FontBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Visibility="{Binding IsBottomGapPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{StaticResource SecondaryPanelBackgroundBrush}" BorderBrush="#42526779" BorderThickness="1" CornerRadius="6" Padding="7,5" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="전후방 거리" Foreground="#82F1D0" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" FontWeight="SemiBold" Margin="2,0,0,3" />
                    <Grid Height="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="51"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="▲" Foreground="#FFB454" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AheadPosition}" Foreground="#FFDBA5" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding AheadName}" Foreground="White" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding AheadGap}" Foreground="#FFCC86" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding AheadDistance}" Foreground="#DDE7F1" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="51"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="▼" Foreground="#57D5FF" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding BehindPosition}" Foreground="#A6EDFF" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding BehindName}" Foreground="White" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding BehindGap}" Foreground="#7FE4FF" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding BehindDistance}" Foreground="#DDE7F1" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource TertiaryPanelBackgroundBrush}" CornerRadius="6" Padding="7,5" Margin="0,6,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding CurrentLabel}" Foreground="#7F95AA" FontSize="{x:Static core:OverlayUiMetrics.FontMicro}" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentLapText}" Foreground="White" FontSize="{x:Static core:OverlayUiMetrics.FontTitle}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}"/></StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="{Binding LastLabel}" Foreground="#7F95AA" FontSize="{x:Static core:OverlayUiMetrics.FontMicro}" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastLapText}" Foreground="#E4EBF2" FontSize="{x:Static core:OverlayUiMetrics.FontTitle}" FontWeight="Medium" Style="{StaticResource HudNumericText}"/></StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding BestLabel}" Foreground="#7F95AA" FontSize="{x:Static core:OverlayUiMetrics.FontMicro}" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding BestLapText}" Foreground="#82F1D0" FontSize="{x:Static core:OverlayUiMetrics.FontTitle}" FontWeight="SemiBold" Style="{StaticResource HudNumericText}"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Sector1Text, StringFormat=S1  {0}}" Foreground="#AFC1D2" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" Style="{StaticResource HudNumericText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Sector2Text, StringFormat=S2  {0}}" Foreground="#AFC1D2" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" Style="{StaticResource HudNumericText}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Sector3Text, StringFormat=S3  {0}}" Foreground="#AFC1D2" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" Style="{StaticResource HudNumericText}"/>
                        <TextBlock Grid.Column="3" Text="{Binding CurrentLapStateText}" Foreground="#82F1D0" FontSize="{x:Static core:OverlayUiMetrics.FontMicro}" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding IsDiagnostic, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="#33445A70" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DiagnosticLabel}" Foreground="#B68CFF" FontWeight="SemiBold" FontSize="10"/>
                    <TextBlock Text="{Binding ParticipantCount, StringFormat=원본 참가자: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding LeagueParticipantCount, StringFormat=리그 참가자: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding SafetyCarsExcluded, StringFormat=제외된 세이프티카: {0}}" Foreground="#FFD166" FontSize="9"/>
                    <TextBlock Text="{Binding TrackLengthText, StringFormat=트랙 길이: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding EventTimeRemainingText, StringFormat=원본 남은 시간: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding CurrentEventText, StringFormat=이벤트: {0}}" Foreground="#B68CFF" FontSize="9"/>
                    <TextBlock Text="{Binding DiagnosticParticipantText, StringFormat=참가자: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding PitScheduleRawText, StringFormat=Pit Schedule Raw: {0}}" Foreground="#FFD166" FontSize="9"/>
                    <TextBlock Text="{Binding PitModeRawText, StringFormat=Pit Mode Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding RaceStateRawText, StringFormat=Race State Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding FlagColourRawText, StringFormat=Flag Colour Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding FlagReasonRawText, StringFormat=Flag Reason Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding DerivedPenaltyText, StringFormat=Derived Penalty: {0}}" Foreground="#FFB454" FontSize="9"/>
                    <TextBlock Text="{Binding DerivedRaceControlText, StringFormat=Race Control: {0}}" Foreground="#82F1D0" FontSize="9"/>
                    <TextBlock Text="{Binding EventProvenanceText, StringFormat=Provenance: {0}}" Foreground="#82F1D0" FontSize="9"/>
                    <TextBlock Text="{Binding EventConfidenceText, StringFormat=Confidence: {0}}" Foreground="#82F1D0" FontSize="9"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
