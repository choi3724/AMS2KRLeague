<UserControl x:Class="AMS2LeagueClient.Presentation.OverlayHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460"
             FontFamily="{DynamicResource HudFontFamily}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             IsHitTestVisible="False">
    <Border CornerRadius="8" Background="#F20A111C" BorderBrush="#8A4DE3B1" BorderThickness="1" Padding="12">
        <StackPanel>
            <Grid Height="30">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="AMS2 LEAGUE · TIMING" Foreground="#F7FAFC" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding RankingRangeText}" Foreground="#82F1D0" FontSize="10" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="4,5,4,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="리그 순위" Foreground="#82F1D0" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="RankingRange" Grid.Column="1" Foreground="#71859B" FontSize="10" FontWeight="Medium" Style="{StaticResource HudNumericText}" />
            </Grid>

            <ItemsControl x:Name="RankingItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="25" Margin="0,1" Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0" Padding="8,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Position}" Foreground="{Binding Foreground}" FontWeight="SemiBold" FontSize="12" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding Foreground}" FontWeight="Medium" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="12" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Visibility="{Binding IsBottomGapPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#EC101C29" BorderBrush="#42526779" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="전후방 거리" Foreground="#82F1D0" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4" />
                    <Grid Height="27">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                        <TextBlock Text="▲" Foreground="#FFB454" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AheadPosition}" Foreground="#FFDBA5" FontSize="12" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding AheadName}" Foreground="White" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding AheadGap}" Foreground="#FFCC86" FontSize="12" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding AheadDistance}" Foreground="#DDE7F1" FontSize="12" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="27">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                        <TextBlock Text="▼" Foreground="#57D5FF" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding BehindPosition}" Foreground="#A6EDFF" FontSize="12" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding BehindName}" Foreground="White" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding BehindGap}" Foreground="#7FE4FF" FontSize="12" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding BehindDistance}" Foreground="#DDE7F1" FontSize="12" FontWeight="SemiBold" Style="{StaticResource HudNumericText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#D9121D2B" CornerRadius="7" Padding="9,7" Margin="0,7,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding CurrentLabel}" Foreground="#7F95AA" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentLapText}" Foreground="White" FontSize="16" FontWeight="SemiBold" Style="{StaticResource HudNumericText}"/></StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="{Binding LastLabel}" Foreground="#7F95AA" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastLapText}" Foreground="#E4EBF2" FontSize="16" FontWeight="Medium" Style="{StaticResource HudNumericText}"/></StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding BestLabel}" Foreground="#7F95AA" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding BestLapText}" Foreground="#82F1D0" FontSize="16" FontWeight="SemiBold" Style="{StaticResource HudNumericText}"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Sector1Text, StringFormat=S1  {0}}" Foreground="#AFC1D2" FontSize="10" Style="{StaticResource HudNumericText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Sector2Text, StringFormat=S2  {0}}" Foreground="#AFC1D2" FontSize="10" Style="{StaticResource HudNumericText}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Sector3Text, StringFormat=S3  {0}}" Foreground="#AFC1D2" FontSize="10" Style="{StaticResource HudNumericText}"/>
                        <TextBlock Grid.Column="3" Text="{Binding CurrentLapStateText}" Foreground="#82F1D0" FontSize="9" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding IsDiagnostic, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#F2070D15" BorderBrush="#33445A70" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,7,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DiagnosticLabel}" Foreground="#B68CFF" FontWeight="SemiBold" FontSize="10"/>
                    <TextBlock Text="{Binding ParticipantCount, StringFormat=원본 참가자: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding LeagueParticipantCount, StringFormat=리그 참가자: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding SafetyCarsExcluded, StringFormat=제외된 세이프티카: {0}}" Foreground="#FFD166" FontSize="9"/>
                    <TextBlock Text="{Binding TrackLengthText, StringFormat=트랙 길이: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding EventTimeRemainingText, StringFormat=원본 남은 시간: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding CurrentEventText, StringFormat=이벤트: {0}}" Foreground="#B68CFF" FontSize="9"/>
                    <TextBlock Text="{Binding DiagnosticParticipantText, StringFormat=참가자: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding PitScheduleRawText, StringFormat=Pit Schedule Raw: {0}}" Foreground="#FFD166" FontSize="9"/>
                    <TextBlock Text="{Binding PitModeRawText, StringFormat=Pit Mode Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding RaceStateRawText, StringFormat=Race State Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding FlagColourRawText, StringFormat=Flag Colour Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding FlagReasonRawText, StringFormat=Flag Reason Raw: {0}}" Foreground="#DDE7F1" FontSize="9"/>
                    <TextBlock Text="{Binding DerivedPenaltyText, StringFormat=Derived Penalty: {0}}" Foreground="#FFB454" FontSize="9"/>
                    <TextBlock Text="{Binding DerivedRaceControlText, StringFormat=Race Control: {0}}" Foreground="#82F1D0" FontSize="9"/>
                    <TextBlock Text="{Binding EventProvenanceText, StringFormat=Provenance: {0}}" Foreground="#82F1D0" FontSize="9"/>
                    <TextBlock Text="{Binding EventConfidenceText, StringFormat=Confidence: {0}}" Foreground="#82F1D0" FontSize="9"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
