<UserControl x:Class="AMS2LeagueClient.Presentation.MultiplayerWaitingOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core"
             FontFamily="{DynamicResource HudFontFamily}"
             ClipToBounds="False"
             IsHitTestVisible="False">
    <Border CornerRadius="10" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="#8257D5FF" BorderThickness="1.5" Padding="16,13">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Foreground="#57D5FF" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontEmphasis}" />
            <TextBlock Text="{Binding SessionLabel}" Foreground="White" FontWeight="SemiBold" FontSize="18" Margin="0,5,0,0" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ParticipantCountText}" Foreground="#91A5B8" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" />
                    <TextBlock Text="{Binding RemainingLabel}" Foreground="#91A5B8" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RemainingValue}" Foreground="#FFCA7A" FontWeight="Bold" FontSize="14" Style="{StaticResource HudNumericText}" VerticalAlignment="Bottom" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
