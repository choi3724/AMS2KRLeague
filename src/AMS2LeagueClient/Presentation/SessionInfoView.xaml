<UserControl x:Class="AMS2LeagueClient.Presentation.SessionInfoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core" FontFamily="{DynamicResource HudFontFamily}" IsHitTestVisible="False">
    <Border CornerRadius="10" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="#654DE3B1" BorderThickness="1" Padding="12,9">
        <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PrimaryLabel}" Foreground="#82F1D0" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PrimaryValue}" Foreground="White" FontWeight="Bold" FontSize="20" Style="{StaticResource HudNumericText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="{Binding PositionLabel}" Foreground="#8FA4B8" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PositionValue}" Foreground="White" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontEmphasis}" Style="{StaticResource HudNumericText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="{Binding LapLabel}" Foreground="#8FA4B8" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontSmall}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LapValue}" Foreground="#FFCA7A" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontEmphasis}" Style="{StaticResource HudNumericText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
