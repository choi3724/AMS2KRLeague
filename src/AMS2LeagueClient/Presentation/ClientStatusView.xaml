<UserControl x:Class="AMS2LeagueClient.Presentation.ClientStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="780" Height="420"
             FontFamily="{DynamicResource HudFontFamily}">
    <Border CornerRadius="24" Background="#F20A111C" BorderBrush="#334B5D73" BorderThickness="1" Padding="34">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AMS2 LEAGUE" Foreground="#7CE8C7" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="PLAYER OVERLAY PoC" Foreground="#F4F7FB" FontWeight="Bold" FontSize="28" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="14" BorderBrush="{Binding AccentColor}" BorderThickness="1" Padding="14,7" VerticalAlignment="Top">
                    <TextBlock Text="{Binding StateLabel}" Foreground="{Binding AccentColor}" FontWeight="Bold" FontSize="13" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,28,0,0">
                <TextBlock Text="{Binding Message}" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Foreground="#AFC0D4" FontSize="14" Margin="0,9,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="3" Background="#80121D2B" CornerRadius="14" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProcessText}" Foreground="#DDE6F0" Style="{DynamicResource HudNumericText}" FontSize="14" Margin="0,4" />
                    <TextBlock Text="{Binding SharedMemoryText}" Foreground="#DDE6F0" Style="{DynamicResource HudNumericText}" FontSize="14" Margin="0,4" />
                    <TextBlock Text="{Binding WindowText}" Foreground="#DDE6F0" Style="{DynamicResource HudNumericText}" FontSize="14" Margin="0,4" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="READ-ONLY SHM" Foreground="#71859B" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Column="1" Text="NO INJECTION" Foreground="#71859B" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="NO INPUT HOOKS" Foreground="#71859B" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
