<Window x:Class="AMS2LeagueClient.Presentation.ClientStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AMS2LeagueClient.Presentation"
        Title="{Binding VersionText}"
        Width="920" Height="650"
        MinWidth="820" MinHeight="600"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        Background="#07101A">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.12" GradientOrigin="0.18,0.12" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#17314B" Offset="0" />
                <GradientStop Color="#07101A" Offset="0.72" />
            </RadialGradientBrush>
        </Grid.Background>
        <local:ClientStatusView HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Text="이 창을 닫으면 오버레이가 종료됩니다. 최소화한 상태에서도 계속 작동합니다."
                   Foreground="#61758B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
    </Grid>
</Window>
