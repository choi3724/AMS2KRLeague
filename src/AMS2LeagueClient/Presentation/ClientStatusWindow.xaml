<Window x:Class="AMS2LeagueClient.Presentation.ClientStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core"
        Title="{Binding VersionText}" Icon="/AMS2LeagueClient;component/Assets/AppIcon.ico"
        Width="1120" Height="900" MinWidth="860" MinHeight="660"
        ShowActivated="True" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource HudFontFamily}" Background="#0C1117" Foreground="#EDF2F6">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C2935" />
            <Setter Property="Foreground" Value="#EDF2F6" />
            <Setter Property="BorderBrush" Value="#354654" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#83D9C0" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#31483E" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GalleryChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DCE5ED" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="#0B1118" BorderBrush="#2C3B47" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <ContentPresenter />
                                <TextBlock x:Name="SelectedLabel" Text="선택됨" FontSize="11" Foreground="#86E6C7"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#75DDBB" />
                                <Setter TargetName="Frame" Property="Background" Value="#10221F" />
                                <Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#B5D8CD" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="GalleryHeader" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AMS2 리그 오버레이" Foreground="#8CDCC4" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="오버레이 선택" FontSize="27" FontWeight="Bold" Margin="0,4,0,4" />
                <TextBlock x:Name="UpdateNotice" Text="{Binding UpdateText}" Foreground="#82E3C3" FontSize="13"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="예시를 보고 필요한 화면을 켜세요. 위치와 크기는 자유롭게 조절할 수 있습니다."
                           FontSize="12" Foreground="#9BACBB" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border BorderBrush="{Binding AccentColor}" BorderThickness="1" CornerRadius="12" Padding="12,4" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StateLabel}" Foreground="{Binding AccentColor}" FontSize="12" />
                </Border>
                <TextBlock Text="{Binding ServerText}" Foreground="#ADBCCA" FontSize="11" Margin="0,8,0,0"
                           MaxWidth="270" TextWrapping="Wrap" TextAlignment="Right" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="표시할 오버레이" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text=" · 미리보기는 예시 데이터입니다" Foreground="#8397A8" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ShowAllButton" Content="모두 켜기" Click="ShowAllButton_Click" Margin="0,0,6,0" Padding="10,5" />
                    <Button x:Name="HideAllButton" Content="모두 끄기" Click="HideAllButton_Click" Margin="0" Padding="10,5" />
                </StackPanel>
            </Grid>
            <Expander x:Name="ConnectionDetails" Grid.Row="1" Header="연결 상태" Foreground="#A8BBCB" FontSize="12" Margin="0,10,0,0">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="20,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#E0EAF2" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Text="{Binding ProcessText}" /><TextBlock Text="{Binding SharedMemoryText}" />
                        <TextBlock Text="{Binding WindowText}" TextWrapping="Wrap" /><TextBlock Text="{Binding ServerText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VrText}" TextWrapping="Wrap" /><TextBlock Text="{Binding AccountText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SessionPlayModeLabel" Text="{Binding SessionPlayModeText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </Grid>
        <ScrollViewer x:Name="GalleryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly" Padding="0,0,10,0">
            <StackPanel x:Name="LayoutVisibilityPanel">
                <CheckBox x:Name="TimingTowerCheck" Tag="{x:Static core:OverlayComponentKeys.TimingTower}" Content="순위 타워" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="PedalTelemetryCheck" Tag="{x:Static core:OverlayComponentKeys.PedalTelemetry}" Content="텔레메트리" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="PedalGaugeCheck" Tag="{x:Static core:OverlayComponentKeys.PedalGauge}" Content="페달 게이지" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="DrivingDashboardCheck" Tag="{x:Static core:OverlayComponentKeys.DrivingDashboard}" Content="레이싱 계기판" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="AvanteClusterCheck" Tag="{x:Static core:OverlayComponentKeys.AvanteCluster}" Content="아반떼 N 계기판 · 일반형" IsChecked="False"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="AvanteClusterExpandedCheck" Tag="{x:Static core:OverlayComponentKeys.AvanteClusterExpanded}" Content="아반떼 N 계기판 · 확장형" IsChecked="False"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="RelativeDriversCheck" Tag="{x:Static core:OverlayComponentKeys.RelativeDrivers}" Content="전후방 거리" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="LapTimingCheck" Tag="{x:Static core:OverlayComponentKeys.LapTiming}" Content="현재·섹터 타임" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="SessionInfoCheck" Tag="{x:Static core:OverlayComponentKeys.SessionInfo}" Content="세션 정보" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="EventCardCheck" Tag="{x:Static core:OverlayComponentKeys.EventCard}" Content="이벤트" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="RaceControlCheck" Tag="{x:Static core:OverlayComponentKeys.RaceControl}" Content="레이스 컨트롤" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="WaitingCheck" Tag="{x:Static core:OverlayComponentKeys.Waiting}" Content="대기 화면" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="SpeedCheck" Tag="{x:Static core:OverlayComponentKeys.Speed}" Content="속도계" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
                <CheckBox x:Name="GearCheck" Tag="{x:Static core:OverlayComponentKeys.Gear}" Content="기어" IsChecked="True"
                          Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" BorderBrush="#263540" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="LayoutEditButton" Content="레이아웃 편집" Click="LayoutEditButton_Click" BorderBrush="#77DDBB" Background="#17382E" />
                    <Button Content="게임 없이 주행 UI 편집" Click="GameplayPreviewButton_Click" />
                    <Button Content="게임 없이 대기 UI 편집" Click="WaitingPreviewButton_Click" />
                    <Button Content="색상·글꼴·핸들 설정" Click="DrivingHudSettingsButton_Click" />
                    <Button Content="모니터·VR 표시 설정" Click="VrSettingsButton_Click" />
                    <Button Content="기본 위치 복원" Click="LayoutResetButton_Click" />
                </WrapPanel>
                <TextBlock x:Name="LayoutHint" Text="표시 여부와 디자인은 바로 저장됩니다. 게임 없이도 위치와 크기를 편집할 수 있습니다."
                           Foreground="#86D9BC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7" />
                <TextBlock Text="최소화해도 계속 작동합니다. 이 창을 닫으면 오버레이가 종료됩니다."
                           Foreground="#788B9B" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
