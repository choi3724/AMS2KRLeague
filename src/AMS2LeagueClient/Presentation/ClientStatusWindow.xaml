<Window x:Class="AMS2LeagueClient.Presentation.ClientStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AMS2LeagueClient.Presentation"
        xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core"
        Title="{Binding VersionText}"
        Width="980" Height="800"
        MinWidth="860" MinHeight="760"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        Background="#07101A">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.12" GradientOrigin="0.18,0.12" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#17314B" Offset="0" />
                <GradientStop Color="#07101A" Offset="0.72" />
            </RadialGradientBrush>
        </Grid.Background>
        <local:ClientStatusView HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,42">
            <StackPanel x:Name="LayoutVisibilityPanel" IsEnabled="False" Opacity="0.45" Margin="0,0,0,9">
                <TextBlock Text="표시할 UI · 편집 중 체크 해제하면 해당 UI를 끕니다" Foreground="#9EB3C7" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <WrapPanel HorizontalAlignment="Center">
                    <CheckBox x:Name="TimingTowerCheck" Tag="{x:Static core:OverlayComponentKeys.TimingTower}" Content="순위 타워" IsChecked="True" Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" Margin="8,2" />
                    <CheckBox x:Name="RelativeDriversCheck" Tag="{x:Static core:OverlayComponentKeys.RelativeDrivers}" Content="전후방 거리" IsChecked="True" Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" Margin="8,2" />
                    <CheckBox x:Name="LapTimingCheck" Tag="{x:Static core:OverlayComponentKeys.LapTiming}" Content="현재·섹터 타임" IsChecked="True" Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" Margin="8,2" />
                    <CheckBox x:Name="SessionInfoCheck" Tag="{x:Static core:OverlayComponentKeys.SessionInfo}" Content="세션 정보" IsChecked="True" Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" Margin="8,2" />
                    <CheckBox x:Name="EventCardCheck" Tag="{x:Static core:OverlayComponentKeys.EventCard}" Content="이벤트" IsChecked="True" Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" Margin="8,2" />
                    <CheckBox x:Name="RaceControlCheck" Tag="{x:Static core:OverlayComponentKeys.RaceControl}" Content="레이스 컨트롤" IsChecked="True" Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" Margin="8,2" />
                    <CheckBox x:Name="WaitingCheck" Tag="{x:Static core:OverlayComponentKeys.Waiting}" Content="대기 화면" IsChecked="True" Checked="LayoutComponentCheck_Changed" Unchecked="LayoutComponentCheck_Changed" Foreground="White" Margin="8,2" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="LayoutEditButton" Content="레이아웃 편집" Click="LayoutEditButton_Click"
                        MinWidth="150" Height="38" Margin="5,0" Padding="15,0" Background="#193247" Foreground="White"
                        BorderBrush="#4DE3B1" BorderThickness="1" FontSize="14" FontWeight="SemiBold" />
                <Button Content="기본 위치 복원" Click="LayoutResetButton_Click"
                        MinWidth="140" Height="38" Margin="5,0" Padding="15,0" Background="#142536" Foreground="#DDE7F1"
                        BorderBrush="#526779" BorderThickness="1" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="LayoutHint" Text="게임 화면이 표시된 상태에서 레이아웃 편집을 누르세요."
                       Foreground="#82F1D0" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Text="이 창을 닫으면 오버레이가 종료됩니다. 최소화한 상태에서도 계속 작동합니다."
                   Foreground="#61758B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
    </Grid>
</Window>
