<UserControl x:Class="AMS2LeagueClient.Presentation.OverlayShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core"
             FontFamily="{DynamicResource HudFontFamily}"
             SnapsToDevicePixels="True"
             IsHitTestVisible="False">
    <Grid x:Name="LayoutRoot">
        <presentation:OverlayHudView x:Name="TimingZone"
                                     xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                     DataContext="{Binding Timing}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />

        <presentation:RelativeDriversView x:Name="RelativeZone"
                                          xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                          DataContext="{Binding Timing}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top" />

        <presentation:LapTimingView x:Name="LapTimingZone"
                                    xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                    DataContext="{Binding Timing}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />

        <presentation:SessionInfoView x:Name="SessionZone"
                                      xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                      Width="224"
                                      Height="120"
                                      DataContext="{Binding Session}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top" />

        <presentation:RaceControlView x:Name="RaceControlZone"
                                      xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                      Width="416"
                                      Height="152"
                                      DataContext="{Binding RaceControl}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border x:Name="EventZone" HorizontalAlignment="Center" VerticalAlignment="Bottom" MinWidth="344" MaxWidth="520"
                Visibility="{Binding EventCard.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                CornerRadius="13" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="{Binding EventCard.Accent}" BorderThickness="1.5" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding EventCard.Arrow}" Foreground="{Binding EventCard.Accent}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding EventCard.Title}" Foreground="{Binding EventCard.Accent}" FontSize="{x:Static core:OverlayUiMetrics.FontTitle}" FontWeight="Bold" />
                    <TextBlock Text="{Binding EventCard.PrimaryText}" Foreground="White" FontSize="{x:Static core:OverlayUiMetrics.FontValue}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding EventCard.SecondaryText}" Foreground="#DDE7F1" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource HudNumericText}" />
                    <Border Visibility="{Binding EventCard.IsDemo, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#665D3FD3" CornerRadius="4" Padding="5,1" Margin="0,3,0,0">
                        <TextBlock Text="DEMO" Foreground="White" FontSize="{x:Static core:OverlayUiMetrics.FontMicro}" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
