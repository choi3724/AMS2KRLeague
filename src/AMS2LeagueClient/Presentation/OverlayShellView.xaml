<UserControl x:Class="AMS2LeagueClient.Presentation.OverlayShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource HudFontFamily}"
             SnapsToDevicePixels="True"
             IsHitTestVisible="False">
    <Grid x:Name="LayoutRoot">
        <presentation:OverlayHudView x:Name="TimingZone"
                                     xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                     DataContext="{Binding Timing}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />

        <presentation:SessionInfoView x:Name="SessionZone"
                                      xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                      Width="280"
                                      Height="150"
                                      DataContext="{Binding Session}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top" />

        <presentation:RaceControlView x:Name="RaceControlZone"
                                      xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
                                      Width="520"
                                      Height="165"
                                      DataContext="{Binding RaceControl}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border x:Name="EventZone" HorizontalAlignment="Center" VerticalAlignment="Bottom" MinWidth="430" MaxWidth="650"
                Visibility="{Binding EventCard.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                CornerRadius="16" Background="#EE09111C" BorderBrush="{Binding EventCard.Accent}" BorderThickness="1.5" Padding="22,15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding EventCard.Arrow}" Foreground="{Binding EventCard.Accent}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding EventCard.Title}" Foreground="{Binding EventCard.Accent}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="{Binding EventCard.PrimaryText}" Foreground="White" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="{Binding EventCard.SecondaryText}" Foreground="#DDE7F1" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource HudNumericText}" />
                    <Border Visibility="{Binding EventCard.IsDemo, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#665D3FD3" CornerRadius="5" Padding="6,2" Margin="0,4,0,0">
                        <TextBlock Text="DEMO" Foreground="White" FontSize="9" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
