<UserControl x:Class="AMS2LeagueClient.Presentation.EventCardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core" FontFamily="{DynamicResource HudFontFamily}" IsHitTestVisible="False">
    <Border x:Name="Panel" MinWidth="344" CornerRadius="13" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="{Binding Accent}" BorderThickness="1.5" Padding="18,12">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Arrow}" Foreground="{Binding Accent}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="{x:Static core:OverlayUiMetrics.FontTitle}" FontWeight="Bold"/><TextBlock Text="{Binding PrimaryText}" Foreground="White" FontSize="{x:Static core:OverlayUiMetrics.FontValue}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{Binding SecondaryText}" Foreground="#DDE7F1" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource HudNumericText}"/><Border Visibility="{Binding IsDemo, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#665D3FD3" CornerRadius="4" Padding="5,1" Margin="0,3,0,0"><TextBlock Text="DEMO" Foreground="White" FontSize="{x:Static core:OverlayUiMetrics.FontMicro}" FontWeight="SemiBold"/></Border></StackPanel>
        </Grid>
    </Border>
</UserControl>
