<UserControl x:Class="AMS2LeagueClient.Presentation.EventCardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{DynamicResource HudFontFamily}" IsHitTestVisible="False">
    <Border x:Name="Panel" MinWidth="430" CornerRadius="16" Background="#EE09111C" BorderBrush="{Binding Accent}" BorderThickness="1.5" Padding="22,15">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Arrow}" Foreground="{Binding Accent}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0" />
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{Binding PrimaryText}" Foreground="White" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock Text="{Binding SecondaryText}" Foreground="#DDE7F1" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource HudNumericText}"/><Border Visibility="{Binding IsDemo, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#665D3FD3" CornerRadius="5" Padding="6,2" Margin="0,4,0,0"><TextBlock Text="DEMO" Foreground="White" FontSize="9" FontWeight="SemiBold"/></Border></StackPanel>
        </Grid>
    </Border>
</UserControl>
