<UserControl x:Class="AMS2LeagueClient.Presentation.RaceControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core" FontFamily="{DynamicResource HudFontFamily}" IsHitTestVisible="False">
    <Border x:Name="Panel" CornerRadius="10" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="{Binding Accent}" BorderThickness="1.5" Padding="14,8" ClipToBounds="True">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Grid>
            <!-- Flag-colour sweep across the banner when a race-control message is presented. -->
            <Border x:Name="FlagSweep" Margin="-14,-8" Opacity="0" IsHitTestVisible="False" Background="{Binding Accent}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
            </Border>
            <!-- The card stretches freely; only text fits uniformly if its
                 wrapped natural height exceeds the available content area. -->
            <Viewbox x:Name="ContentFit" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
            <Grid x:Name="Body" Width="385">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="Heading" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontEmphasis}" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <Border Grid.Column="1" Background="#332B3A49" CornerRadius="5" Padding="6,1" VerticalAlignment="Top" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock x:Name="CountText" Text="{Binding CountText}" Foreground="#DDE7F1" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" Style="{StaticResource HudNumericText}"/></Border>
                </Grid>
                <StackPanel x:Name="ExpandedContent" Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                    <TextBlock x:Name="DriverText" Text="{Binding DriverLine}" Foreground="White" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontEmphasis}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Text="{Binding Message}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock x:Name="HistoryText" Text="{Binding HistoryText}" Foreground="#8FA4B8" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="StateLabelText" Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StateLabel}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontBody}" Margin="0,4,0,0" HorizontalAlignment="Right" TextWrapping="Wrap" RenderTransformOrigin="1,0.5">
                    <TextBlock.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
