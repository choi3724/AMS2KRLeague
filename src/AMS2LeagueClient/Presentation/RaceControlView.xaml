<UserControl x:Class="AMS2LeagueClient.Presentation.RaceControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:AMS2LeagueClient.Core.Presentation;assembly=AMS2LeagueClient.Core" FontFamily="{DynamicResource HudFontFamily}" IsHitTestVisible="False">
    <Border x:Name="Panel" CornerRadius="10" Background="{StaticResource MainPanelBackgroundBrush}" BorderBrush="{Binding Accent}" BorderThickness="1.5" Padding="14,8">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="{x:Static core:OverlayUiMetrics.FontEmphasis}" />
                <Border Grid.Column="1" Background="#332B3A49" CornerRadius="5" Padding="6,1"><TextBlock Text="{Binding CountText}" Foreground="#DDE7F1" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" Style="{StaticResource HudNumericText}"/></Border>
            </Grid>
            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                <TextBlock Text="{Binding DriverLine}" Foreground="White" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontEmphasis}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Message}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="17" />
                <TextBlock Text="{Binding HistoryText}" Foreground="#8FA4B8" FontSize="{x:Static core:OverlayUiMetrics.FontTiny}" Margin="0,5,0,0" LineHeight="12" />
            </StackPanel>
            <TextBlock Text="{Binding StateLabel}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="{x:Static core:OverlayUiMetrics.FontBody}" Margin="0,4,0,0" HorizontalAlignment="Right" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
