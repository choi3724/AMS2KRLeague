<Window x:Class="AMS2LeagueClient.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
        Title="AMS2 Timing Tower"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        MinWidth="120" MinHeight="80"
        SizeToContent="Manual">
    <Grid>
        <Viewbox Stretch="Uniform">
            <presentation:OverlayHudView x:Name="TimingHud" />
        </Viewbox>
        <Grid x:Name="EditChrome" Visibility="Collapsed">
            <Border BorderBrush="#FF4DE3B1" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
            <Border Height="30" VerticalAlignment="Top" Background="#F0203447" BorderBrush="#FF4DE3B1" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="EditDrag_MouseLeftButtonDown">
                <TextBlock Text="순위 타워 · 드래그" Foreground="White" FontSize="13" FontWeight="Bold" Margin="9,0" VerticalAlignment="Center" />
            </Border>
            <ResizeGrip Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#DD4DE3B1" Cursor="SizeNWSE" />
        </Grid>
    </Grid>
</Window>
