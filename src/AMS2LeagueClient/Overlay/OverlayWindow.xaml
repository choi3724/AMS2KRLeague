<Window x:Class="AMS2LeagueClient.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:AMS2LeagueClient.Presentation"
        Title="AMS2 Timing Tower"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        MinWidth="120" MinHeight="80"
        SizeToContent="Manual">
    <Grid>
        <Viewbox Stretch="Uniform" VerticalAlignment="Top">
            <presentation:OverlayHudView x:Name="TimingHud" />
        </Viewbox>
        <Grid x:Name="EditChrome" Visibility="Collapsed">
            <Border BorderBrush="#FF4DE3B1" BorderThickness="2" CornerRadius="6" Background="Transparent"
                    Cursor="SizeAll" ToolTip="순위 타워 · 드래그로 이동 / 오른쪽 아래 모서리로 크기 조절"
                    MouseLeftButtonDown="EditDrag_MouseLeftButtonDown" />
            <ResizeGrip Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" />
        </Grid>
    </Grid>
</Window>
