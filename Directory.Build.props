<Project>
  <PropertyGroup>
    <Version>0.8.3</Version>
    <VersionPrefix>0.8.3</VersionPrefix>
    <AssemblyVersion>0.8.3.0</AssemblyVersion>
    <FileVersion>0.8.3.0</FileVersion>
    <InformationalVersion>0.8.3</InformationalVersion>
    <Product>AMS2 League Overlay</Product>
    <Description>Read-only Korean player overlay for Automobilista 2.</Description>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
</Project>
